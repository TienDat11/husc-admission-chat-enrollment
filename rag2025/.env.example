# ============================================================
# .env.example – Copy to .env and fill in your values
# ============================================================

# Admission year authority — DA PIN 2026 (data cycle hien tai, max data_year=2026).
# Bump len 2027 CHI khi ingest du lieu 2027.
CURRENT_ADMISSION_YEAR=2026

# ─── LLM GATEWAY: ns24 (the ONLY LLM credential/provider) ────
# Whitelist (enforced at startup): gpt-6-luna, deepseek-v4.1-flash,
#   gemini-3.8-flash, gemini-3.5-flash-lite, claude-haiku-5-5
# Role routing (role: primary → fallback):
#   default / router / ner / hyde / guardrail : gemini-3.5-flash-lite → deepseek-v4.1-flash
#   gen                                       : gpt-6-luna            → claude-haiku-5-5
NS24_API_KEY=sk-your-ns24-key-here
NS24_BASE_URL=https://api.ns24.io/v1
NS24_STREAM=true
NS24_MODEL=gemini-3.5-flash-lite
NS24_FALLBACK_MODEL=deepseek-v4.1-flash
NS24_ROUTER_MODEL=gemini-3.5-flash-lite
NS24_ROUTER_FALLBACK_MODEL=deepseek-v4.1-flash
NS24_NER_MODEL=gemini-3.5-flash-lite
NS24_NER_FALLBACK_MODEL=deepseek-v4.1-flash
NS24_HYDE_MODEL=gemini-3.5-flash-lite
NS24_HYDE_FALLBACK_MODEL=deepseek-v4.1-flash
NS24_GUARDRAIL_MODEL=gemini-3.5-flash-lite
NS24_GUARDRAIL_FALLBACK_MODEL=deepseek-v4.1-flash
NS24_GEN_MODEL=gpt-6-luna
NS24_GEN_FALLBACK_MODEL=claude-haiku-5-5
# NS24_VISION_MODEL=<image-capable model>  (scripts/vision_crawl_husc.py only; unverified on ns24)

# ─── VECTOR DATABASE (LanceDB embedded) ──────────────────────
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=husc_chunks
LANCEDB_ENTITY_TABLE=husc_entities
USE_LANCEDB=true

# ─── EMBEDDING MODEL ─────────────────────────────────────────
# EMBEDDING_PROVIDER controls which prompt strategy to use.
# Set EMBEDDING_MODEL + EMBEDDING_DIM to match your chosen provider.
#
# ┌───────────┬──────────────────────────────────┬──────┬────────┐
# │ Provider  │ Model                            │ Dim  │ Disk   │
# ├───────────┼──────────────────────────────────┼──────┼────────┤
# │ qwen      │ Qwen/Qwen3-Embedding-0.6B       │ 1024 │ 1.2GB  │
# │ qwen      │ Qwen/Qwen3-Embedding-4B         │ 2560 │ 8GB    │
# │ qwen      │ Qwen/Qwen3-Embedding-8B         │ 4096 │ 15GB   │
# │ harrier   │ microsoft/harrier-oss-v1-270m    │  640 │ 0.5GB  │
# │ harrier   │ microsoft/harrier-oss-v1-0.6b    │ 1024 │ 1.2GB  │
# │ harrier   │ microsoft/harrier-oss-v1-27b     │ 5376 │ 54GB   │
# │ bge       │ BAAI/bge-m3                      │ 1024 │ 2.2GB  │
# └───────────┴──────────────────────────────────┴──────┴────────┘
#
# Default: Qwen3-Embedding-0.6B (khớp bảng LanceDB production, dim=1024)
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# Presets (used by benchmark scripts; not needed at runtime)
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QWEN_EMBEDDING_DIM=2560
HARRIER_EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
HARRIER_EMBEDDING_DIM=1024
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_EMBEDDING_DIM=1024

# ─── HUGGINGFACE CACHE (redirect to D: drive to avoid filling C:) ──────────
# Models download here. Default is C:\Users\<user>\.cache\huggingface (~20GB for 8B!)
# Change to D: drive path that has enough free space:
HF_HOME=D:/huggingface_cache
TRANSFORMERS_CACHE=D:/huggingface_cache/hub
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_ENABLED=false
RERANKER_WEIGHT=0.35
GUARDRAIL_ENABLED=true
ERROR_EXPOSURE_MODE=dev

# ─── GRAPHRAG TUNING ─────────────────────────────────────────
# GRAPHRAG_ALPHA=0.6       # weight for vector score (1-alpha = PPR weight)
# GRAPHRAG_PPR_ALPHA=0.85  # PageRank damping factor
# GRAPHRAG_SIMPLE_THRESHOLD=2  # complexity <= this → PaddedRAG, else GraphRAG

# ─── API SERVER ───────────────────────────────────────────────
LOG_LEVEL=INFO

# Hard constraint C1: generation max_tokens
MAX_GEN_TOKENS=1500

# ─── ADMIN AUTH (T08: password login + session cookie) ─────────────────
# Shared ops/machine credential (role 'ops'). Never a human actor.
# ADMIN_API_TOKEN=change-me-ops
#
# Human actor registry: JSON array of {"token","actor_id","role"}.
# Roles: viewer, editor, reviewer, publisher, reviewer_publisher, admin.
# ADMIN_IDENTITIES=[{"token":"tk-soan","actor_id":"soan.nguyen","role":"editor"}]
#
# Four-eyes: approver must differ from version author. ON by default.
# Set to 0/false to disable (record the reason; the ledger stores it).
# ADMIN_FOUR_EYES=1

# ─── T13: Docker / Caddy (only needed when running via docker compose) ──────
# Public domain for Caddy automatic HTTPS (Let's Encrypt).
# Leave unset (or "localhost") for local dev — Caddy uses its internal CA.
# DOMAIN=husc.edu.vn
#
# ACME admin email (required by Caddy when DOMAIN is a public domain)
# ADMIN_EMAIL=ops@example.com

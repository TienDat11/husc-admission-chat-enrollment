# ============================================================
# .env.example – Copy to .env and fill in your values
# ============================================================

# ─── PRIMARY LLM (AI Box – DeepSeek v4) ──────────────────────
# Get your key from your AI Box account
RAMCLOUDS_API_KEY=sk-your-key-here
RAMCLOUDS_BASE_URL=https://api.ai-box.vn/v1
RAMCLOUDS_MODEL=deepseek-v4-flash


# ─── FALLBACK LLM (Groq – free, fast) ───────────────────────
# Get your key from https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_ROUTER_MODEL=llama-3.3-70b-versatile
GROQ_NER_MODEL=llama-3.1-8b-instant

# ─── NER FALLBACK (Qwen-3.5-Plus via Aliyun) ────────────────
# Optional – only needed if both ramclouds + groq fail for NER
# QWEN_API_KEY=sk-your-qwen-key-here

# ─── VECTOR DATABASE (LanceDB embedded) ──────────────────────
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=rag2025
LANCEDB_ENTITY_TABLE=husc_entities
USE_LANCEDB=true

# ─── EMBEDDING MODEL ─────────────────────────────────────────
# EMBEDDING_PROVIDER controls which prompt strategy to use.
# Set EMBEDDING_MODEL + EMBEDDING_DIM to match your chosen provider.
#
# ┌───────────┬──────────────────────────────────┬──────┬────────┐
# │ Provider  │ Model                            │ Dim  │ Disk   │
# ├───────────┼──────────────────────────────────┼──────┼────────┤
# │ qwen      │ Qwen/Qwen3-Embedding-0.6B       │ 1024 │ 1.2GB  │
# │ qwen      │ Qwen/Qwen3-Embedding-4B         │ 2560 │ 8GB    │
# │ qwen      │ Qwen/Qwen3-Embedding-8B         │ 4096 │ 15GB   │
# │ harrier   │ microsoft/harrier-oss-v1-270m    │  640 │ 0.5GB  │
# │ harrier   │ microsoft/harrier-oss-v1-0.6b    │ 1024 │ 1.2GB  │
# │ harrier   │ microsoft/harrier-oss-v1-27b     │ 5376 │ 54GB   │
# │ bge       │ BAAI/bge-m3                      │ 1024 │ 2.2GB  │
# └───────────┴──────────────────────────────────┴──────┴────────┘
#
# Default: Qwen3-Embedding-0.6B (khớp bảng LanceDB production, dim=1024)
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# Presets (used by benchmark scripts; not needed at runtime)
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QWEN_EMBEDDING_DIM=2560
HARRIER_EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
HARRIER_EMBEDDING_DIM=1024
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_EMBEDDING_DIM=1024

# ─── HUGGINGFACE CACHE (redirect to D: drive to avoid filling C:) ──────────
# Models download here. Default is C:\Users\<user>\.cache\huggingface (~20GB for 8B!)
# Change to D: drive path that has enough free space:
HF_HOME=D:/chunking/.cache/huggingface
TRANSFORMERS_CACHE=D:/chunking/.cache/huggingface/hub
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_ENABLED=true
RERANKER_WEIGHT=0.35
GUARDRAIL_ENABLED=true
GUARDRAIL_MODEL=llama-3.3-70b-versatile
ERROR_EXPOSURE_MODE=dev

# ─── GRAPHRAG TUNING ─────────────────────────────────────────
# GRAPHRAG_ALPHA=0.6       # weight for vector score (1-alpha = PPR weight)
# GRAPHRAG_PPR_ALPHA=0.85  # PageRank damping factor
# GRAPHRAG_SIMPLE_THRESHOLD=2  # complexity <= this → PaddedRAG, else GraphRAG

# ─── API SERVER ───────────────────────────────────────────────
LOG_LEVEL=INFO
RAMCLOUDS_NER_MODEL=deepseek-v4-flash
RAMCLOUDS_HYDE_MODEL=deepseek-v4-flash
RAMCLOUDS_ROUTER_MODEL=deepseek-v4-flash
RAMCLOUDS_GEN_MODEL=deepseek-v4-pro
RAMCLOUDS_GEN_FALLBACK_MODEL=deepseek-v4-flash

# Hard constraint C1: generation max_tokens
MAX_GEN_TOKENS=1500
